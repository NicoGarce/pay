RewriteEngine On

# 1) External redirect: *.php -> clean URL (without .php) for GET only
RewriteCond %{THE_REQUEST} \s(.+?)\.php[\s?] [NC]
RewriteCond %{REQUEST_METHOD} !POST
RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

# 2) Internal rewrite: clean URL -> .php if the php file exists
#    Supports /new-enrollee, /enrolled, /other, /checkout, /admin/students, /admin/monitoring, /admin/login etc.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# 3) Allow directory index
DirectoryIndex index.php
